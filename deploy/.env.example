POLYTRADER_IMAGE=ghcr.io/paulbeka/polytrader@sha256:REPLACE_WITH_RELEASE_DIGEST
POLYTRADER_ROOT=/srv/polytrader
# Optional. Collector uploads nightly when bucket is configured.
# POLYTRADER_BACKUP_BUCKET=your-private-bucket
# POLYTRADER_BACKUP_PREFIX=polytrader
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-2
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# POLYTRADER_ALERT_WEBHOOK=https://your-webhook
